# Copy this file to .env and fill in real values yourself (do not paste tokens into chat).
# .env is git-ignored — see ../.gitignore

# Bot User OAuth Token (starts with xoxb-) — from "OAuth & Permissions" after Install to Workspace
SLACK_BOT_TOKEN=

# User OAuth Token (starts with xoxp-) — obtained via the one-time authorize flow, see get-user-token.js
SLACK_USER_TOKEN=

# App-Level Token (starts with xapp-) — from "Basic Information" > "App-Level Tokens",
# needs the connections:write scope. Only needed for the Socket Mode listener (cli/listen.js).
SLACK_APP_TOKEN=

# Signing Secret — from "Basic Information" > "App Credentials".
# Only required when the optional HTTP endpoint/slash-command surface is enabled.
SLACK_SIGNING_SECRET=

# Default channel for outbound posts (optional, not currently read by post.js —
# reserved for a future default-channel convenience flag)
SLACK_DEFAULT_CHANNEL=#your-channel-name

# App credentials, needed only for the one-time user-token exchange (from "Basic Information")
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
