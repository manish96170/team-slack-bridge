{
  "name": "team-slack-bridge",
  "version": "0.1.5",
  "description": "Post to Slack (as a bot, or explicitly as a specific authorized user) and DM, from any script, agent, or CI job. Standalone — no dependency on any particular orchestration system.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manish96170/team-slack-bridge.git"
  },
  "bin": {
    "team-slack-bridge": "post.js"
  },
  "scripts": {
    "get-user-token": "node get-user-token.js",
    "post": "node post.js",
    "verify-dm": "node verify-dm.js",
    "doctor": "node cli/doctor.js",
    "mcp": "node mcp/server.js",
    "mcp-daemon": "node cli/mcp-daemon.js",
    "accounts": "node cli/accounts.js",
    "repos": "node cli/repos.js",
    "agent-sessions": "node cli/agent-session.js",
    "build:sea": "node scripts/build-sea.mjs",
    "listen": "node cli/listen.js",
    "daemon": "node cli/daemon.js",
    "http": "node cli/http.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=26"
  },
  "files": [
    "post.js",
    "get-user-token.js",
    "verify-dm.js",
    "env.js",
    "core",
    "cli",
    "listen",
    "mcp",
    "skill",
    "config",
    ".env.example",
    ".nvmrc",
    "README.md",
    "FEATURES.md",
    "PLAN.md",
    "TODO.md",
    "ROADMAP.md",
    "LICENSE"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@slack/bolt": "^5.1.0",
    "@slack/web-api": "^8.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
